#include <winver.h>

1 ICON "{ICON}"

VS_VERSION_INFO VERSIONINFO
FILEVERSION {MAJOR}, {MINOR}, {PATCH}, 0
PRODUCTVERSION {MAJOR}, {MINOR}, {PATCH}, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "Rub19"
      VALUE "FileDescription", "Ethone"
      VALUE "FileVersion", "{VERSION}"
      VALUE "InternalName", "ethone-native"
      VALUE "OriginalFilename", "ethone-native.exe"
      VALUE "ProductName", "Ethone"
      VALUE "ProductVersion", "{VERSION}"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x040C, 1200
  END
END
