global Look {
    out property <color> bg: #0b0f1a;
    out property <color> card: #141a2a;
    out property <color> line: #ffffff1a;
    out property <color> fg: #f4f6fb;
    out property <color> muted: #9aa3b8;
    out property <color> accent: #0a84ff;
    out property <color> accent-hover: #3399ff;
    out property <color> glow-a: #2f6bff;
    out property <color> glow-b: #7c4dff;
    out property <color> ok: #30d158;
    out property <color> bad: #ff453a;
}

component Glow inherits Rectangle {
    in property <color> ink;
    in property <float> strength;
    background: @radial-gradient(circle, ink.with-alpha(strength) 0%, ink.with-alpha(0) 70%);
}

component Action inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked();
    height: 40px;
    min-width: 120px;
    border-radius: 10px;
    background: !root.enabled ? Look.line : root.primary ? (touch.has-hover ? Look.accent-hover : Look.accent) : (touch.has-hover ? #ffffff26 : #ffffff14);
    animate background { duration: 120ms; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    Text {
        text: root.text;
        color: root.enabled ? Look.fg : Look.muted;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Check inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    height: 30px;
    HorizontalLayout {
        spacing: 10px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 36px;
                height: 22px;
                border-radius: 11px;
                background: root.checked ? Look.ok : #ffffff26;
                animate background { duration: 150ms; }
                Rectangle {
                    x: root.checked ? parent.width - self.width - 3px : 3px;
                    y: 3px;
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: white;
                    animate x { duration: 180ms; easing: cubic-bezier(0.23, 1, 0.32, 1); }
                }
            }
        }
        Text {
            text: root.text;
            color: Look.fg;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; }
    }
    accessible-role: checkbox;
    accessible-checked: root.checked;
    accessible-label: root.text;
}

component Screen inherits Rectangle {
    in property <bool> shown;
    in property <bool> reduced;
    opacity: root.shown ? 1 : 0;
    visible: self.opacity > 0.01;
    animate opacity { duration: root.reduced ? 0ms : 240ms; easing: cubic-bezier(0.23, 1, 0.32, 1); }
}

export component SetupWindow inherits Window {
    title: root.window-title;
    icon: @image-url("../../app/assets/ethone-logo.png");
    no-frame: true;
    width: 520px;
    height: 440px;
    background: Look.bg;
    default-font-size: 13px;
    default-font-family: "Segoe UI Variable Text";

    in property <string> window-title;
    in property <string> screen: "welcome";
    in property <bool> reduced;
    in property <string> heading;
    in property <string> detail;
    in property <string> path-label;
    in property <string> path;
    in property <string> primary-label;
    in property <string> secondary-label;
    in property <string> desktop-label;
    in property <string> autostart-label;
    in property <bool> show-options;
    in-out property <bool> desktop;
    in-out property <bool> autostart;
    in property <float> progress;
    in property <string> status;
    in property <string> done-heading;
    in property <string> done-detail;
    in property <string> open-label;
    in property <string> close-label;
    in property <bool> can-open;
    in property <string> error-text;
    in property <string> retry-label;
    in property <string> version-label;

    callback primary();
    callback secondary();
    callback open-app();
    callback close-window();
    callback minimize();
    callback drag();
    callback retry();

    Glow {
        x: parent.width * 0.35;
        y: -parent.height * 0.45;
        width: parent.width;
        height: parent.width;
        ink: Look.glow-a;
        strength: 0.30;
    }
    Glow {
        x: -parent.width * 0.45;
        y: parent.height * 0.45;
        width: parent.width;
        height: parent.width;
        ink: Look.glow-b;
        strength: 0.26;
    }
    Rectangle {
        border-width: 1.5px;
        border-radius: 8px;
        property <angle> turn: root.reduced ? 45deg : mod(animation-tick(), 9s) / 9s * 360deg;
        border-color: @linear-gradient(self.turn, root.screen == "done" ? Look.ok : Look.glow-a 0%, #ffffff00 45%, #ffffff00 55%, root.screen == "done" ? Look.ok : Look.glow-b 100%);
    }
    TouchArea {
        y: 0;
        height: 40px;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.drag();
            }
        }
    }
    HorizontalLayout {
        y: 0;
        height: 36px;
        alignment: end;
        padding-right: 6px;
        for item[index] in ["min", "close"]: Rectangle {
            width: 40px;
            border-radius: 6px;
            background: control.has-hover ? (item == "close" ? #e81123 : #ffffff1a) : transparent;
            Path {
                width: 10px;
                height: 10px;
                commands: item == "close" ? "M 0 0 L 10 10 M 10 0 L 0 10" : "M 0 5 L 10 5";
                stroke: Look.fg;
                stroke-width: 1.2px;
                viewbox-width: 10;
                viewbox-height: 10;
            }
            control := TouchArea {
                clicked => {
                    if (item == "close") {
                        root.close-window();
                    } else {
                        root.minimize();
                    }
                }
            }
        }
    }

    VerticalLayout {
        padding: 32px;
        padding-top: 40px;
        spacing: 14px;
        HorizontalLayout {
            alignment: center;
            logo := Rectangle {
                width: 72px;
                height: 72px;
                property <float> pulse: root.reduced || root.screen != "progress" ? 0 : (1 + sin(mod(animation-tick(), 1600ms) / 1600ms * 360deg)) / 2;
                drop-shadow-blur: 24px + 14px * self.pulse;
                drop-shadow-color: Look.glow-a.with-alpha(0.45);
                border-radius: 20px;
                Image {
                    width: 100%;
                    height: 100%;
                    source: @image-url("../../app/assets/ethone-logo.png");
                    image-fit: contain;
                }
                Rectangle {
                    visible: root.screen == "done";
                    x: parent.width - 22px;
                    y: parent.height - 22px;
                    width: 28px;
                    height: 28px;
                    border-radius: 14px;
                    background: Look.ok;
                    border-width: 3px;
                    border-color: Look.bg;
                    transform-scale: root.screen == "done" ? 1 : 0.4;
                    animate transform-scale { duration: root.reduced ? 0ms : 320ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
                    Text {
                        text: "✓";
                        color: white;
                        font-size: 14px;
                        font-weight: 800;
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            Screen {
                shown: root.screen == "welcome" || root.screen == "uninstall";
                reduced: root.reduced;
                VerticalLayout {
                    spacing: 10px;
                    Text {
                        text: root.heading;
                        color: Look.fg;
                        font-size: 22px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.detail;
                        color: Look.muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Rectangle { height: 4px; }
                    Rectangle {
                        border-radius: 10px;
                        background: #ffffff0d;
                        border-width: 1px;
                        border-color: Look.line;
                        height: 48px;
                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: center;
                            Text {
                                text: root.path-label;
                                color: Look.muted;
                                font-size: 11px;
                            }
                            Text {
                                text: root.path;
                                color: Look.fg;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                    }
                    if root.show-options: VerticalLayout {
                        spacing: 2px;
                        Check {
                            text: root.desktop-label;
                            checked <=> root.desktop;
                        }
                        Check {
                            text: root.autostart-label;
                            checked <=> root.autostart;
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
            Screen {
                shown: root.screen == "progress";
                reduced: root.reduced;
                VerticalLayout {
                    spacing: 14px;
                    alignment: center;
                    Text {
                        text: root.heading;
                        color: Look.fg;
                        font-size: 20px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Rectangle {
                        height: 8px;
                        border-radius: 4px;
                        background: #ffffff1a;
                        clip: true;
                        Rectangle {
                            x: 0;
                            width: parent.width * clamp(root.progress, 0, 1);
                            border-radius: 4px;
                            background: @linear-gradient(90deg, Look.glow-a 0%, Look.glow-b 100%);
                            animate width { duration: root.reduced ? 0ms : 200ms; easing: cubic-bezier(0.23, 1, 0.32, 1); }
                        }
                    }
                    HorizontalLayout {
                        Text {
                            text: root.status;
                            color: Look.muted;
                            font-size: 12px;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: round(clamp(root.progress, 0, 1) * 100) + " %";
                            color: Look.muted;
                            font-size: 12px;
                        }
                    }
                }
            }
            Screen {
                shown: root.screen == "done";
                reduced: root.reduced;
                VerticalLayout {
                    spacing: 10px;
                    alignment: center;
                    Text {
                        text: root.done-heading;
                        color: Look.fg;
                        font-size: 22px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.done-detail;
                        color: Look.muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
            Screen {
                shown: root.screen == "error";
                reduced: root.reduced;
                VerticalLayout {
                    spacing: 10px;
                    alignment: center;
                    Text {
                        text: root.heading;
                        color: Look.bad;
                        font-size: 20px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.error-text;
                        color: Look.muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: root.version-label;
                color: Look.muted;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.screen == "welcome" || root.screen == "uninstall": Action {
                text: root.secondary-label;
                clicked => { root.secondary(); }
            }
            if root.screen == "welcome" || root.screen == "uninstall": Action {
                text: root.primary-label;
                primary: true;
                clicked => { root.primary(); }
            }
            if root.screen == "done" || root.screen == "error": Action {
                text: root.close-label;
                clicked => { root.close-window(); }
            }
            if root.screen == "done" && root.can-open: Action {
                text: root.open-label;
                primary: true;
                clicked => { root.open-app(); }
            }
            if root.screen == "error": Action {
                text: root.retry-label;
                primary: true;
                clicked => { root.retry(); }
            }
        }
    }
}
