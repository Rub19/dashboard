{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ethone Setup",
  "mainBinaryName": "ethone-setup",
  "version": "0.1.0",
  "identifier": "dev.ethone.desktop.setup",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5191"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ethone Setup",
        "width": 720,
        "height": 580,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../src-tauri/icons/32x32.png", "../src-tauri/icons/128x128.png", "../src-tauri/icons/128x128@2x.png", "../src-tauri/icons/icon.ico"]
  }
}
