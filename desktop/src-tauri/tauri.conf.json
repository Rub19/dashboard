{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ethone",
  "mainBinaryName": "ethone",
  "version": "0.1.0",
  "identifier": "dev.ethone.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5190",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ethone",
        "width": 440,
        "height": 660,
        "decorations": false,
        "center": true,
        "transparent": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; media-src https://media.valorant-api.com https://valorant.dyn.riotcdn.net; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Rub19",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "ethone"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzMEE0NDM5MDNCMjAxODAKUldTQUFiSURPVVFLVXp6NElHNW9VRGFjK1hmeVFkVG5tanREZ201alowYUd3bC9UOWxpZS81R0wK",
      "endpoints": [
        "https://github.com/Rub19/dashboard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
