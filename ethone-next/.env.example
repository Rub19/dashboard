# ETHONE OS — Configuration Stripe
NEXT_PUBLIC_STRIPE_DONATION_URL=https://donate.stripe.com/test_fZu5kD8923u73gn3Bv4Ni00

# Cloudflare Turnstile (bot protection on signup / reset-password / OTP login)
# This is baked in at build time (static export on Cloudflare Pages) — set it
# in the Pages project's environment variables, not just here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Google Gemini API (translation system)
GEMINI_API_KEY=your_api_key_here

# OpenRouter API (free models translation system)
OPENROUTER_API_KEY=your_openrouter_api_key_here
