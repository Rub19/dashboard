; Projet Godot 4.x — Dino Corridor (portage natif du prototype HTML).
; Phase 2 : dinosaures, armes, HUD, score, menus, sons procéduraux.

config_version=5

[application]

config/name="Dino Corridor"
config/description="Portage natif (Godot) du prototype raycasting HTML : couloirs, dinosaures, armes, score et niveaux progressifs."
run/main_scene="res://Main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="mobile"
