    "Sondage intégré de Discord : simple et fiable, mais sans quorum, vote pondéré ni éligibilité. Un salon et une seule question, 32 jours maximum.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discord's built-in poll: simple and reliable, but no quorum, weighted vote or eligibility. One channel and one question, 32 days max."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuesta integrada de Discord: sencilla y fiable, pero sin quórum, voto ponderado ni elegibilidad. Un canal y una sola pregunta, 32 días como máximo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Discords integrierte Umfrage: einfach und zuverlässig, aber ohne Quorum, gewichtete Stimmen oder Berechtigung. Ein Kanal und eine Frage, höchstens 32 Tage."
          }
        }
      }
    },
