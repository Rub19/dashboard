    "Accueil et Plus restent toujours dans la barre. Maintenez une ligne pour la déplacer, balayez pour la retirer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home and More always stay in the bar. Hold a row to move it, swipe to remove it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicio y Más siempre se quedan en la barra. Mantén una fila para moverla, desliza para quitarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Start und Mehr bleiben immer in der Leiste. Halte eine Zeile zum Verschieben gedrückt, wische zum Entfernen."
          }
        }
      }
    },
