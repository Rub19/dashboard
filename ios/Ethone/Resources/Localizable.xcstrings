        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorios de tareas, hábitos y eventos, y fin de las sesiones de concentración. Las notificaciones enviadas por el servidor requieren una versión firmada de la app."
          }
        },
        "de": {
          "stringUnit": {
