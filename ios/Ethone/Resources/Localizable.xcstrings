    "« Auto » reprend l'accent du thème. Les boutons pleins s'assombrissent automatiquement si la couleur choisie est trop claire pour un texte blanc.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Auto\" uses the theme's accent. Filled buttons darken automatically if the chosen color is too light for white text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Auto» usa el acento del tema. Los botones rellenos se oscurecen automáticamente si el color elegido es demasiado claro para un texto blanco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Auto“ übernimmt den Akzent des Designs. Gefüllte Buttons werden automatisch dunkler, wenn die Farbe für weißen Text zu hell ist."
          }
        }
      }
    },
