    "Nécessite une clé API Riot enregistrée sur votre compte ETHONE (Connexions, sur le site).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires a Riot API key saved on your ETHONE account (Connections, on the website)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere una clave API de Riot guardada en tu cuenta ETHONE (Conexiones, en el sitio)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert einen in deinem ETHONE-Konto gespeicherten Riot-API-Schlüssel (Verbindungen, auf der Website)."
          }
        }
      }
    },
    "Nécessite une clé API Riot enregistrée sur votre compte ETHONE (Connexions, sur le site). Aucune clé n'est saisie ni stockée dans l'app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires a Riot API key saved on your ETHONE account (Connections, on the website). No key is entered or stored in the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere una clave API de Riot guardada en tu cuenta ETHONE (Conexiones, en el sitio). Ninguna clave se introduce ni se guarda en la app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert einen in deinem ETHONE-Konto gespeicherten Riot-API-Schlüssel (Verbindungen, auf der Website). In der App wird kein Schlüssel eingegeben oder gespeichert."
          }
        }
      }
    },
    "Nécessite une clé API tracker.gg enregistrée sur votre compte ETHONE (Connexions, sur le site). Seuls les jeux pris en charge par l'API publique de tracker.gg sont proposés.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires a tracker.gg API key saved on your ETHONE account (Connections, on the website). Only games supported by the public tracker.gg API are offered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Requiere una clave API de tracker.gg guardada en tu cuenta ETHONE (Conexiones, en el sitio). Solo se proponen los juegos compatibles con la API pública de tracker.gg."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert einen in deinem ETHONE-Konto gespeicherten tracker.gg-API-Schlüssel (Verbindungen, auf der Website). Nur von der öffentlichen tracker.gg-API unterstützte Spiele werden angeboten."
          }
        }
      }
    },
