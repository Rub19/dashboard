{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raspy-fog-bf5b",
  "main": "src/index.js",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "production",
    "WORKER_VERSION": "1.0.0",
    "ALLOWED_ORIGINS": "https://ethone.dev",
    "SUPABASE_AUDIENCE": "authenticated",
    "OUTBOUND_TIMEOUT_MS": "6500",
    "AI_PRIMARY_PROVIDER": "cloudflare",
    "AI_PRIMARY_MODEL": "@cf/meta/llama-3.3-70b-instruct-v1",
    "AI_FALLBACK_PROVIDER": "groq",
    "AI_FALLBACK_MODEL": "llama-3.3-70b-versatile",
    "AI_CLOUDFLARE_DAILY_ALLOCATION": "10000",
    "AI_CLOUDFLARE_DAILY_BUDGET": "8000",
    "AI_CLOUDFLARE_EMERGENCY_BUFFER": "2000",
    "AI_CLOUDFLARE_WARNING_PCT": "0.8",
    "AI_CLOUDFLARE_PREPARE_PCT": "0.9",
    "AI_CLOUDFLARE_HARDSTOP_PCT": "1.0",
    "AI_NEURONS_PER_TOKEN": "0.1",
    "AI_MAX_RETRIES": "0",
    "AI_RETRY_BASE_MS": "250",
    "AI_USER_REQUESTS_PER_HOUR": "60",
    "AI_USER_REQUESTS_PER_DAY": "500",
    "AI_USER_MAX_PROMPT_CHARS": "12000",
    "AI_USER_MAX_OUTPUT_TOKENS": "1024",
    "AI_USER_MAX_CONTEXT_CHARS": "12000",
    "AI_USAGE_LOGGING_ENABLED": "true",
    "CLOUDFLARE_ACCOUNT_ID": "75759ee1ee5d85996815e55926ab1a4a"
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_QUOTA_MANAGER",
        "class_name": "AiQuotaManager"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v2",
      "new_sqlite_classes": ["AiQuotaManager"]
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMIT_EDGE",
      "namespace_id": "811401",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_STANDARD",
      "namespace_id": "811402",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_STRICT",
      "namespace_id": "811403",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
